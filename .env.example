# PostgreSQL
POSTGRES_USER=risk
POSTGRES_PASSWORD=local-risk-db-password
POSTGRES_DB=risk
POSTGRES_HOST_PORT=15432

# Redis
REDIS_HOST_PORT=16379

# Neo4j
NEO4J_PASSWORD=local-risk-graph-password
NEO4J_HTTP_HOST_PORT=17474
NEO4J_BOLT_HOST_PORT=17687

# RustFS and document storage
RUSTFS_API_HOST_PORT=19000
RUSTFS_CONSOLE_HOST_PORT=19001
RUSTFS_ROOT_ACCESS_KEY=RISKROOTADMIN2026
RUSTFS_ROOT_SECRET_KEY=local-rustfs-root-change-me-2026
STORAGE_ACCESS_KEY=RISKDOCUMENTSAPP2026
STORAGE_SECRET_KEY=local-rustfs-app-change-me-2026
STORAGE_BUCKET=risk-documents

# Frontend, gateway and session cookie
FRONTEND_HOST_PORT=18080
GATEWAY_HOST_PORT=18081
COOKIE_SECURE=false

# Backend application logging; use json when a server-side collector consumes logs.
RISK_LOG_LEVEL=INFO
RISK_LOG_FORMAT=pretty

# Independent RiskGNN service and model storage
RISK_GNN_DB_PASSWORD=local-riskgnn-db-password
RISK_GNN_API_TOKEN=local-riskgnn-change-me
MODELING_STORAGE_BUCKET=risk-modeling
MODELING_STORAGE_ACCESS_KEY=RISKMODELINGAPP2026
MODELING_STORAGE_SECRET_KEY=local-modeling-change-me
# Host development only: run the model API on 8001 and set RISK_GNN_URL accordingly.
# RISK_GNN_URL=http://localhost:8001

# Deployed UK financial LoRA; model directory is relative to models/weights/.
# Install a verified bundle including base/ before enabling inference; startup never downloads.
# CPU is the default. For CUDA use compose.gpu.yaml; see docs/features/uk-decision-model/integration.md.
DECISION_ENABLED=true
DECISION_MODEL_DIRECTORY=uk-financial-0.6b-v1
DECISION_DEVICE=cpu
DECISION_DTYPE=float32
DECISION_CPU_THREADS=4
DECISION_TIMEOUT_SECONDS=60

# Optional proxy for Docker image build steps; host proxy URL can use host.docker.internal.
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1,host.docker.internal
# Optional Go module mirror for the gateway build; empty uses the Go default.
BUILD_GOPROXY=

# Agent model; API key is only passed to the backend (raw token, no Bearer prefix).
# qwen_self_hosted: Qwen self-hosted API; minimax: MiniMax-M3 for local debugging.
# Set true to enable thinking for local debugging; false keeps competition non-thinking mode.
# See docs/architecture/agent-model-config.md.
RISK_LLM_CONNECTION_TYPE=qwen_self_hosted
RISK_LLM_THINKING_ENABLED=false
RISK_LLM_URL=http://172.16.4.3:8080/v1/chat/completions
RISK_LLM_MODEL=Qwen3.6-35B-A3B
RISK_LLM_API_KEY=

# Internal script executor; generated code never receives this token or service credentials.
