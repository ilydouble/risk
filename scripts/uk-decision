#!/usr/bin/env bash
set -euo pipefail

if ! command -v uv >/dev/null 2>&1; then
  echo "请先安装 uv: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 127
fi

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"
# Keep the caller's cwd so --adapter/--archive and output paths retain their usual meaning.
exec uv run --project "${repo_root}/models/service" --locked python -m scripts.uk_decision "$@"
