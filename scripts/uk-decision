#!/usr/bin/env bash
set -euo pipefail

if ! command -v uv >/dev/null 2>&1; then
  echo "请先安装 uv: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 127
fi

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${repo_root}${PYTHONPATH:+:${PYTHONPATH}}"
# --with-base uses this public HF snapshot; Release contains only the LoRA bundle and data.
# https://huggingface.co/Qwen/Qwen3-0.6B/tree/c1899de289a04d12100db370d81485cdf75e47ca
# Keep the caller's cwd so input/output paths retain their usual meaning.
exec uv run --project "${repo_root}/models/service" --locked python -m model_service.cli delivery "$@"
