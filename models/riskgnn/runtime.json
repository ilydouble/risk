{
  "contract_version": 2,
  "name": "RiskGNN+",
  "description": "RiskGNN+ with ordinary graphs, induced hypergraphs, event encoding and dual-branch evidence.",
  "operations": {
    "inspect": {
      "inputs": {
        "dataset": {
          "kind": "file",
          "formats": [
            "zip"
          ],
          "required": true
        }
      },
      "parameters_schema": {
        "additionalProperties": false,
        "properties": {
          "target_operation": {
            "const": "train",
            "default": "train",
            "title": "Target Operation",
            "type": "string"
          }
        },
        "title": "InspectParameters",
        "type": "object"
      },
      "default_parameters": {
        "target_operation": "train"
      },
      "result_schema": {
        "$defs": {
          "CompatibilityIssue": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "minLength": 1,
                "title": "Code",
                "type": "string"
              },
              "message": {
                "minLength": 1,
                "title": "Message",
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "title": "CompatibilityIssue",
            "type": "object"
          },
          "DatasetProfile": {
            "additionalProperties": false,
            "properties": {
              "datasetFormat": {
                "minLength": 1,
                "title": "Datasetformat",
                "type": "string"
              },
              "taskType": {
                "minLength": 1,
                "title": "Tasktype",
                "type": "string"
              },
              "target": {
                "minLength": 1,
                "title": "Target",
                "type": "string"
              },
              "evaluation": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Evaluation"
              },
              "features": {
                "anyOf": [
                  {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Features"
              },
              "splits": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/SplitSummary"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Splits"
              },
              "relations": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/RelationSummary"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Relations"
              },
              "metadata": {
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "title": "Metadata",
                "type": "object"
              }
            },
            "required": [
              "datasetFormat",
              "taskType",
              "target"
            ],
            "title": "DatasetProfile",
            "type": "object"
          },
          "EnterpriseExportSummary": {
            "additionalProperties": false,
            "properties": {
              "format": {
                "const": "risk-enterprise-data-v1",
                "default": "risk-enterprise-data-v1",
                "title": "Format",
                "type": "string"
              },
              "counts": {
                "additionalProperties": {
                  "minimum": 0,
                  "type": "integer"
                },
                "propertyNames": {
                  "enum": [
                    "company",
                    "person",
                    "edge",
                    "hyperedge",
                    "event"
                  ]
                },
                "title": "Counts",
                "type": "object"
              }
            },
            "required": [
              "counts"
            ],
            "title": "EnterpriseExportSummary",
            "type": "object"
          },
          "InspectedFile": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "minLength": 1,
                "title": "Path",
                "type": "string"
              },
              "size": {
                "minimum": 0,
                "title": "Size",
                "type": "integer"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "title": "Sha256",
                "type": "string"
              }
            },
            "required": [
              "path",
              "size",
              "sha256"
            ],
            "title": "InspectedFile",
            "type": "object"
          },
          "JsonValue": {},
          "RelationSummary": {
            "additionalProperties": false,
            "properties": {
              "type": {
                "minLength": 1,
                "title": "Type",
                "type": "string"
              },
              "count": {
                "minimum": 0,
                "title": "Count",
                "type": "integer"
              }
            },
            "required": [
              "type",
              "count"
            ],
            "title": "RelationSummary",
            "type": "object"
          },
          "SplitSummary": {
            "additionalProperties": false,
            "properties": {
              "split": {
                "minLength": 1,
                "title": "Split",
                "type": "string"
              },
              "count": {
                "minimum": 0,
                "title": "Count",
                "type": "integer"
              },
              "positives": {
                "minimum": 0,
                "title": "Positives",
                "type": "integer"
              },
              "seed": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Seed"
              }
            },
            "required": [
              "split",
              "count",
              "positives"
            ],
            "title": "SplitSummary",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Public inspect result after successful validation AND enterprise export.",
        "properties": {
          "protocol": {
            "minLength": 1,
            "title": "Protocol",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "files": {
            "items": {
              "$ref": "#/$defs/InspectedFile"
            },
            "minItems": 1,
            "title": "Files",
            "type": "array"
          },
          "counts": {
            "additionalProperties": {
              "minimum": 0,
              "type": "integer"
            },
            "propertyNames": {
              "minLength": 1
            },
            "title": "Counts",
            "type": "object"
          },
          "features": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Features",
            "type": "array"
          },
          "labeledCount": {
            "minimum": 0,
            "title": "Labeledcount",
            "type": "integer"
          },
          "positiveCount": {
            "minimum": 0,
            "title": "Positivecount",
            "type": "integer"
          },
          "datasetProfile": {
            "$ref": "#/$defs/DatasetProfile"
          },
          "splits": {
            "items": {
              "$ref": "#/$defs/SplitSummary"
            },
            "title": "Splits",
            "type": "array"
          },
          "root": {
            "default": ".",
            "title": "Root",
            "type": "string"
          },
          "relations": {
            "items": {
              "$ref": "#/$defs/RelationSummary"
            },
            "title": "Relations",
            "type": "array"
          },
          "analysis": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Analysis"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "metadata": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Metadata",
            "type": "object"
          },
          "datasetContract": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Datasetcontract",
            "type": "object"
          },
          "supportedRunnerIds": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Supportedrunnerids",
            "type": "array"
          },
          "compatibility": {
            "enum": [
              "compatible",
              "incompatible"
            ],
            "title": "Compatibility",
            "type": "string"
          },
          "issues": {
            "items": {
              "$ref": "#/$defs/CompatibilityIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "enterpriseData": {
            "$ref": "#/$defs/EnterpriseExportSummary"
          }
        },
        "required": [
          "protocol",
          "sha256",
          "files",
          "counts",
          "features",
          "labeledCount",
          "positiveCount",
          "datasetProfile",
          "splits",
          "datasetContract",
          "supportedRunnerIds",
          "compatibility",
          "issues",
          "enterpriseData"
        ],
        "title": "InspectionOutput",
        "type": "object"
      },
      "artifacts": {
        "enterprises": {
          "format": "risk-enterprise-data-v1",
          "kind": "file",
          "required": true
        }
      },
      "ui_schema": {}
    },
    "train": {
      "inputs": {
        "dataset": {
          "kind": "file",
          "formats": [
            "zip"
          ],
          "required": true
        }
      },
      "parameters_schema": {
        "additionalProperties": false,
        "properties": {
          "epochs": {
            "default": 2,
            "maximum": 250,
            "minimum": 1,
            "title": "Epochs",
            "type": "integer"
          },
          "dataset": {
            "type": "object",
            "default": {}
          },
          "algorithm": {
            "type": "string",
            "const": "riskgnn-plus",
            "default": "riskgnn-plus"
          },
          "fusion": {
            "type": "string",
            "enum": [
              "legacy",
              "adaptive"
            ]
          }
        },
        "title": "TrainParameters",
        "type": "object"
      },
      "default_parameters": {
        "epochs": 2,
        "dataset": {},
        "algorithm": "riskgnn-plus"
      },
      "result_schema": {
        "$defs": {
          "JsonObject": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "JsonValue": {}
        },
        "additionalProperties": false,
        "properties": {
          "profile": {
            "$ref": "#/$defs/JsonObject"
          },
          "companies": {
            "items": {
              "type": "string"
            },
            "title": "Companies",
            "type": "array"
          }
        },
        "required": [
          "profile",
          "companies"
        ],
        "title": "TrainingSummary",
        "type": "object"
      },
      "artifacts": {
        "model": {
          "format": "riskgnn-plus-model-v1",
          "kind": "directory",
          "required": true
        }
      },
      "ui_schema": {
        "fields": [
          {
            "path": "dataset.target_count",
            "label": {
              "zh": "目标企业总数",
              "en": "Target companies"
            },
            "description": {
              "zh": "训练、验证、测试目标的总数，保留已有划分；不足时使用可用目标。",
              "en": "Total training, validation and test targets; preserves existing splits and uses available targets if fewer."
            }
          },
          {
            "path": "epochs",
            "label": {
              "zh": "训练轮数",
              "en": "Training epochs"
            },
            "description": {
              "zh": "在选定数据范围上执行的训练轮数，最多 250 轮。",
              "en": "Training epochs on the selected data, up to 250."
            }
          }
        ]
      }
    },
    "evaluate": {
      "inputs": {
        "model": {
          "kind": "directory",
          "formats": [
            "riskgnn-plus-model-v1",
            "riskgnn-model-v2"
          ],
          "required": true
        }
      },
      "parameters_schema": {
        "additionalProperties": false,
        "properties": {},
        "title": "Parameters",
        "type": "object"
      },
      "default_parameters": {},
      "result_schema": {
        "$defs": {
          "JsonObject": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "JsonValue": {}
        },
        "additionalProperties": false,
        "properties": {
          "report": {
            "$ref": "#/$defs/JsonObject"
          }
        },
        "required": [
          "report"
        ],
        "title": "EvaluationSummary",
        "type": "object"
      },
      "artifacts": {
        "report": {
          "format": "riskgnn-evaluation-v2",
          "kind": "directory",
          "required": true
        }
      },
      "ui_schema": {}
    },
    "predict": {
      "inputs": {
        "model": {
          "kind": "directory",
          "formats": [
            "riskgnn-plus-model-v1",
            "riskgnn-model-v2"
          ],
          "required": true
        }
      },
      "parameters_schema": {
        "additionalProperties": false,
        "properties": {
          "company_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Company Ids",
            "type": "array"
          },
          "explain": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "company_ids"
        ],
        "title": "PredictParameters",
        "type": "object"
      },
      "default_parameters": {},
      "result_schema": {
        "$defs": {
          "Prediction": {
            "additionalProperties": false,
            "properties": {
              "companyId": {
                "title": "Companyid",
                "type": "string"
              },
              "probability": {
                "maximum": 1,
                "minimum": 0,
                "title": "Probability",
                "type": "number"
              },
              "predictedLabel": {
                "enum": [
                  0,
                  1
                ],
                "title": "Predictedlabel",
                "type": "integer"
              },
              "fusedProbability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "uncertainty": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "conflict": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "nodeProbability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "graphProbability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "explanation": {
                "type": "object"
              }
            },
            "required": [
              "companyId",
              "probability",
              "predictedLabel"
            ],
            "title": "Prediction",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/Prediction"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "PredictionSummary",
        "type": "object"
      },
      "artifacts": {},
      "ui_schema": {}
    },
    "configure": {
      "inputs": {},
      "parameters_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_contract"
        ],
        "properties": {
          "dataset_contract": {
            "type": "object"
          },
          "requested_parameters": {
            "type": "object",
            "default": {}
          },
          "expected_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "default_parameters": {
        "requested_parameters": {}
      },
      "result_schema": {
        "type": "object",
        "required": [
          "configVersion",
          "schemaDigest",
          "parameterSchema",
          "defaultParameters",
          "uiSchema",
          "requestedParameters",
          "resolvedParameters",
          "dataset",
          "adapter"
        ]
      },
      "artifacts": {},
      "ui_schema": {}
    }
  },
  "runtime_id": "riskgnn",
  "runtime_version": "3",
  "dataset_formats": [
    "sg-comrisk-v1",
    "smesd-json-v5",
    "uk-dataset-v1",
    "uk-research-v2"
  ]
}
