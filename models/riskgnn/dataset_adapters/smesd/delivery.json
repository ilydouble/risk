{
  "adapter": {
    "id": "smesd",
    "version": "1"
  },
  "required_files": [
    "train.json",
    "valid.json",
    "test.json"
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_count": {
        "type": "integer",
        "minimum": 6,
        "maximum": 20000
      }
    }
  },
  "default_config": {
    "target_count": 4000
  },
  "presets": {
    "smesd": {
      "dataset": {
        "id": "smesd",
        "name": "SMEsD V5 JSON snapshots"
      },
      "description": "SMEsD V5 JSON snapshots; node_edge subset, preserving existing splits."
    }
  }
}
