{
  "adapter": {
    "id": "uk-dataset-v1",
    "version": "2"
  },
  "required_files": [
    "train.json",
    "valid.json",
    "test.json",
    "audit.json",
    "export_meta.json",
    "feature-policy.json",
    "split-audit.csv"
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_count": {
        "type": "integer",
        "minimum": 6,
        "maximum": 300000
      }
    }
  },
  "default_config": {
    "target_count": 2000
  },
  "presets": {
    "uk-companies": {
      "dataset": {
        "id": "uk-companies",
        "name": "UK research observations and typed hypergraphs"
      },
      "description": "12-month insolvency targets; company-disjoint temporal splits, financial trends, no event inputs."
    }
  }
}
