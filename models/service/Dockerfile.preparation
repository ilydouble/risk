FROM risk-riskgnn:local AS libraries
FROM ghcr.io/astral-sh/uv:0.8.22-python3.12-bookworm-slim
COPY --from=libraries /opt/venv /opt/venv
WORKDIR /app/models
COPY riskgnn ./riskgnn
COPY risk_dataset_contract.schema.json ./
COPY service/preparation_bootstrap.py /opt/preparation_bootstrap.py
ENV PATH="/opt/venv/bin:${PATH}" PYTHONPATH=/app/models PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python", "/opt/preparation_bootstrap.py"]
